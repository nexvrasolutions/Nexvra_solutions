# Copy to .env and fill in real values. Never commit .env.
# On Vercel, set these in Project → Settings → Environment Variables instead
# (do NOT set NODE_ENV there; Vercel manages it).

# --- Supabase project (Dashboard → Project Settings → API) ---
SUPABASE_URL=https://<project-ref>.supabase.co
# Server-only secret used for Storage uploads. Never expose it to the browser
# (no NEXT_PUBLIC_ prefix). "service_role" key (eyJ...) or a "sb_secret_..." key.
SUPABASE_SERVICE_ROLE_KEY=
# Not used by the app at the moment; safe to leave empty.
SUPABASE_ANON_KEY=

# --- Database (Dashboard → Connect → Session/Transaction pooler) ---
# Runtime connection (lib/prisma.ts) uses the DB_POOLER_* values.
DB_POOLER_HOST=aws-0-<region>.pooler.supabase.com
# 5432 = session pooler; 6543 = transaction pooler (recommended on Vercel/serverless).
DB_POOLER_PORT=5432
DB_POOLER_USER=postgres.<project-ref>
DB_POOLER_PASSWORD=
# Prisma CLI (migrate deploy) and a required presence check at runtime.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Supabase root CA. Optional: the bundled supabase-ca.cer/prod-ca-2021.crt is used
# when this is empty or the path does not exist (e.g. on Vercel).
SUPABASE_CA_CERT=
# Alternative to the file: paste the certificate text (\n for new lines).
SUPABASE_CA_CERT_PEM=

# --- App ---
# Public base URL encoded in student QR codes. Production: https://<your-domain>
# Vercel Preview deployments automatically use their own preview URL instead.
APP_URL=http://localhost:3000
# At least 32 random characters (e.g. `openssl rand -base64 48`).
JWT_SECRET=

# --- Admin bootstrap (scripts/create-admin.ts, prisma/seed.ts) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
