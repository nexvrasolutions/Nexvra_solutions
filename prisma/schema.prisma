generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  REJECTED
}

enum ProgramType {
  COURSE
  INTERNSHIP
  CUSTOM
}

model Department {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  students Student[]
}

model Institution {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  students Student[]
}

model ProgramTypeOption {
  id        String    @id @default(cuid())
  name      String    @unique
  value     ProgramType @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  students Student[]
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  approvedEnrollments Enrollment[] @relation("ApprovedByAdmin")
}

model Course {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  slug        String   @unique
  description String?
  duration    String?
  syllabus    String?
  technologies String[] @default([])
  skills      String[] @default([])
  projects   String[] @default([])
  level       String?
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments Enrollment[]
}

model Student {
  id                   String         @id @default(cuid())
  studentCode          String         @unique
  fullName             String
  /// Optional; still unique when provided (Postgres allows many NULLs).
  email                String?        @unique
  /// Contact number. Optional.
  phone                String?
  address              String?
  /// Public URL of the photo in Supabase Storage (students/ folder).
  studentPhoto         String?
  /// Free-text course name shown on the certificate. Required for new students.
  courseName           String?
  /// Fixed provider values: every certificate is issued by Nexvra Solutions.
  instituteName        String         @default("Nexvra Solutions")
  learnedFrom          String         @default("Nexvra Solutions")
  batchStartDate       DateTime?      @db.Date
  batchEndDate         DateTime?      @db.Date
  /// Legacy free-text institution from the earlier form; kept for old records.
  institution          String?
  department           String?
  batch                String?
  programType          ProgramType?   @default(COURSE)
  profileToken         String         @unique
  profileQrPath        String?
  publicProfileEnabled Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  enrollments Enrollment[]
  departmentOption Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  departmentId       String?
  institutionOption Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  institutionId      String?
  programTypeOption ProgramTypeOption? @relation(fields: [programTypeOptionId], references: [id], onDelete: SetNull)
  programTypeOptionId String?
}

model Enrollment {
  id             String            @id @default(cuid())
  studentId      String
  courseId       String
  enrollmentDate DateTime          @default(now())
  status         EnrollmentStatus  @default(ACTIVE)
  completionDate DateTime?
  approvedById   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  student      Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course       Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  approvedBy   AdminUser?  @relation("ApprovedByAdmin", fields: [approvedById], references: [id])

  @@unique([studentId, courseId])
}
